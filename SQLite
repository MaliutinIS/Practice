PRAGMA foreign_keys = ON;

CREATE TABLE Role (
    RoleID   INTEGER PRIMARY KEY AUTOINCREMENT,
    RoleName TEXT NOT NULL
);

CREATE TABLE "User" (
    UserID         INTEGER PRIMARY KEY AUTOINCREMENT,
    UserSurname    TEXT NOT NULL,
    UserName       TEXT NOT NULL,
    UserPatronymic TEXT,
    UserLogin      TEXT NOT NULL UNIQUE,
    UserPassword   TEXT NOT NULL,
    UserRole       INTEGER NOT NULL,
    FOREIGN KEY (UserRole) REFERENCES Role(RoleID)
);

CREATE TABLE OrderStatus (
    StatusID   INTEGER PRIMARY KEY AUTOINCREMENT,
    StatusName TEXT NOT NULL UNIQUE
);

CREATE TABLE PickupPoint (
    PickupPointID      INTEGER PRIMARY KEY AUTOINCREMENT,
    PickupPointAddress TEXT NOT NULL UNIQUE
);

CREATE TABLE Client (
    ClientID         INTEGER PRIMARY KEY AUTOINCREMENT,
    ClientSurname    TEXT NOT NULL,
    ClientName       TEXT NOT NULL,
    ClientPatronymic TEXT,
    ClientLogin      TEXT NOT NULL UNIQUE,
    ClientPassword   TEXT NOT NULL
);

CREATE TABLE "Order" (
    OrderID           INTEGER PRIMARY KEY AUTOINCREMENT,
    OrderNumber       INTEGER NOT NULL UNIQUE,
    OrderDate         TEXT NOT NULL,
    OrderDeliveryDate TEXT NOT NULL,
    PickupPointID     INTEGER NOT NULL,
    ClientID          INTEGER,
    PickupCode        TEXT NOT NULL,
    OrderStatusID     INTEGER NOT NULL,
    FOREIGN KEY (PickupPointID) REFERENCES PickupPoint(PickupPointID),
    FOREIGN KEY (ClientID)      REFERENCES Client(ClientID),
    FOREIGN KEY (OrderStatusID) REFERENCES OrderStatus(StatusID)
);

CREATE TABLE Product (
    ProductArticleNumber     TEXT PRIMARY KEY,
    ProductName              TEXT NOT NULL,
    ProductDescription       TEXT,
    ProductCategory          TEXT NOT NULL,
    ProductPhoto             BLOB,
    ProductManufacturer      TEXT NOT NULL,
    ProductSupplier          TEXT NOT NULL,
    ProductUnit              TEXT NOT NULL,
    ProductCost              REAL NOT NULL,
    ProductMaxDiscountPercent INTEGER NOT NULL,
    ProductDiscountAmount    INTEGER,
    ProductQuantityInStock   INTEGER NOT NULL
);

CREATE TABLE OrderProduct (
    OrderID              INTEGER NOT NULL,
    ProductArticleNumber TEXT NOT NULL,
    Quantity             INTEGER NOT NULL CHECK (Quantity > 0),
    PRIMARY KEY (OrderID, ProductArticleNumber),
    FOREIGN KEY (OrderID)              REFERENCES "Order"(OrderID),
    FOREIGN KEY (ProductArticleNumber) REFERENCES Product(ProductArticleNumber)
);

